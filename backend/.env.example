# Server
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=train_ticket_db

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=5

# Email (Nodemailer)
EMAIL_ENABLED=true
EMAIL_MOCK=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Train Booking <noreply@trainbooking.com>
EMAIL_REPLY_TO=support@trainbooking.com
APP_NAME=Train Ticket Booking
APP_URL=http://localhost:3000
SUPPORT_EMAIL=support@trainbooking.com

# SMS (mock by default; set provider for Twilio)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CORS
CORS_ORIGIN=http://localhost:5173

# Dynamic pricing (optional overrides)
PRICING_CURRENCY=BDT
PRICING_CURRENCY_SYMBOL=৳
PRICING_OCCUPANCY_BASE_MAX=50
PRICING_OCCUPANCY_MEDIUM_MAX=80
PRICING_OCCUPANCY_BASE_MULT=1.0
PRICING_OCCUPANCY_MEDIUM_MULT=1.2
PRICING_OCCUPANCY_HIGH_MULT=1.4
PRICING_TIME_URGENT_DAYS=1
PRICING_TIME_SOON_DAYS=3
PRICING_TIME_NEAR_DAYS=7
PRICING_TIME_URGENT_MULT=1.15
PRICING_TIME_SOON_MULT=1.08
PRICING_TIME_NEAR_MULT=1.03
PRICING_MAX_MULT=2.0
