NODE_ENV=development
PORT=3000
# For production behind local Nginx: HOST=127.0.0.1 and TRUST_PROXY=loopback
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=train_ticket_db
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5
CORS_ORIGIN=http://localhost:5173
EMAIL_ENABLED=false
EMAIL_MOCK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=RailBook <noreply@example.com>
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Production: configure real SMTP/Twilio credentials, disable mocks, and set JWT_SECRET.
